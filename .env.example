# Database (Supabase): DATABASE_URL = pooled (port 6543, ?pgbouncer=true), DIRECT_URL = direct (port 5432) for migrations
DATABASE_URL=postgres://wav:wav@localhost:5432/wav
DIRECT_URL=postgres://wav:wav@localhost:5432/wav
# 32+ random characters; signs the iron-session cookie and OTP hashes
SESSION_SECRET=
# Bearer token required by /api/cron/*
CRON_SECRET=
# Supabase Storage (private bucket for referral letters and payment proofs)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=wellness-ave-private
# Dev only: local folder used instead of Supabase Storage when SUPABASE_URL is unset
FILE_ROOT=.data/files
# Meta WhatsApp Cloud API
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_GRAPH_VERSION=v21.0
# Meta-approved template names once approved, e.g. {"T1":"wellness_ave_fu_received"} (defaults in src/server/messaging/templates.ts)
WA_TEMPLATE_NAMES=
WA_TEMPLATE_LANGUAGE=en
# Twilio Programmable Messaging
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# First admin (created by pnpm db:seed; TOTP enrolment URI is printed)
ADMIN_EMAIL=kniquiah.hughes@gmail.com
ADMIN_INITIAL_PASSWORD=
# Public origin, e.g. https://book.wellnessave.com
APP_BASE_URL=http://localhost:3000
# Dev only: append messages the console stub "sends" to this file (used by e2e tests)
MESSAGING_LOG_FILE=
# Tests only: disposable database for pnpm test (tables are truncated)
TEST_DATABASE_URL=postgres://wav:wav@localhost:5432/wav_test
